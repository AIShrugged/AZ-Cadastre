# registry
NODE_ENV=production
SERVICE_PORT=3100
SERVICE_HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cadastre-registry?schema=public
WORKBOOK_CLASSIFIER_PROVIDER=mock
WORKBOOK_CLASSIFIER_MODEL=openai/gpt-4o
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=AZ-Cadastre

# migrate
REGISTRY_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cadastre-registry?schema=public

# postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cadastre-registry

# rustfs
RUSTFS_ROOT_USER=rustfsadmin
RUSTFS_ROOT_PASSWORD=rustfsadmin
RUSTFS_ADDRESS=:9000
RUSTFS_CONSOLE_ADDRESS=:9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_LOG=warn
RUSTFS_NOTIFY_ENABLE=true
RUSTFS_NOTIFY_WEBHOOK_ENABLE_PRIMARY=on
RUSTFS_NOTIFY_WEBHOOK_ENDPOINT_PRIMARY=http://cadastre-backend:3000/api/storage/events
RUSTFS_NOTIFY_WEBHOOK_QUEUE_DIR_PRIMARY=/tmp/rustfs-events
RUSTFS_OUTBOUND_ALLOW_ORIGINS=http://cadastre-backend:3000
