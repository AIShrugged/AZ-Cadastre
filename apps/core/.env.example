# Environment for the running service. Copy to .env (or .env.local, which wins).
#
# Both the composition root and the contexts it mounts read from the process
# environment, so this one file carries the app's own variables and every
# context's. Migrations are run from the context package instead and read that
# package's own .env — see libs/contexts/verification/.env.example.

# ── Service (composition root) ──────────────────────────────────────────────
SERVICE_PORT=3000
SERVICE_HOST=0.0.0.0

# Origin of the web app, allowed by CORS (API + presigned bucket uploads)
WEB_ORIGIN=http://localhost:5173

# ── verification context: database (PostgreSQL) ─────────────────────────────
# The context owns this database. Nothing else may connect to it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cadastre-db?schema=public

# ── verification context: object storage (RustFS / S3) ─────────────────────
# Endpoint must be reachable from BOTH this service and the browser, since the
# presigned URL points straight at it. For local RustFS that's localhost:9000.
S3_ENDPOINT=http://localhost:9000
S3_REGION=rustfs
S3_BUCKET=documents
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL=600

# ── verification context: OpenRouter ────────────────────────────────────────
# Shared by the real OCR, classifier and extractor adapters. Required only when
# a provider below is set to "openrouter".
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=AZ-Cadastre

# ── verification context: OCR ───────────────────────────────────────────────
# "mock" derives text from the filename; "openrouter" runs a real vision model
# over the uploaded image bytes.
OCR_PROVIDER=mock
OCR_MODEL=google/gemini-2.5-flash

# ── verification context: classification ────────────────────────────────────
# "mock" matches English keywords; "openrouter" asks an LLM (language-agnostic).
CLASSIFIER_PROVIDER=mock
CLASSIFIER_MODEL=google/gemini-2.5-flash

# ── verification context: field extraction ──────────────────────────────────
# "mock" returns fixed demo values; "openrouter" pulls schema fields via an LLM.
EXTRACTOR_PROVIDER=mock
EXTRACTOR_MODEL=google/gemini-2.5-flash
