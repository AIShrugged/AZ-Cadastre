# The register stand-in's environment. Copy to .env (or .env.local, which wins).
#
# It is a service of its own and not part of the monolith: it stands in for a
# system outside this one, so it has its own port, its own log level and — the
# point of this file — its own database (ADR-0009, ADR-0010).

SERVICE_PORT=3100
SERVICE_HOST=0.0.0.0

# fatal | error | warn | info | debug | trace | silent. "debug" adds every SQL
# statement the lookup runs; "trace" adds its parameters, which are somebody's
# address, so it is for a local database and nothing else.
LOG_LEVEL=info
LOG_PRETTY=true

# ── The register's own database ─────────────────────────────────────────────
# NOT cadastre-db. That one belongs to the verification context, which owns it;
# this is a different system that happens to run on the same PostgreSQL server.
# Create it once with:
#   docker exec -i cadastre-postgres createdb -U postgres cadastre-registry
# then `pnpm --filter @cadastre/registry-stub db:migrate` and `db:seed`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cadastre-registry?schema=public

# ── Which of the archive's registers an uploaded workbook is ────────────────
# The import takes two shapes and works out which it is holding (ADR-0012).
# One is the register's own template, recognised by its `Objects` sheet, and
# nobody is asked about it. The other is one of the six files the archive
# actually keeps, and this decides who recognises those:
#
#   mock       the register's own rule — scores the file's sheet names and
#              column headers against the catalogue in
#              src/domain/archive-registers/. No key, no network, and it is
#              what the model-backed one is compared against.
#   openrouter a model reads the same shape. This is what a file from an office
#              that renamed a sheet or added a column needs.
#
# The model may only name a register the catalogue carries; anything else and
# the rule's answer stands. A provider that cannot be reached is a warning and
# the rule's answer, never a failed upload — so switching this on cannot break
# an import, it can only fail to improve one. The report's `detectedBy` says
# which of the two decided.
WORKBOOK_CLASSIFIER_PROVIDER=mock
WORKBOOK_CLASSIFIER_MODEL=openai/gpt-4o

# Only read when WORKBOOK_CLASSIFIER_PROVIDER=openrouter. Leave the key out of
# this file: it belongs in .env.local, which is not in git.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=AZ-Cadastre
