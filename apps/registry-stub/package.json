{
  "name": "@cadastre/registry-stub",
  "version": "1.0.0",
  "description": "The stand-in for the archive register: an HTTP service that answers what the cadastre archive holds about a property. It answers from its own PostgreSQL database, seeded with the cases the customer supplied; the contract it answers is the part that does not change.",
  "type": "module",
  "main": "./build/main.js",
  "scripts": {
    "dev": "node --watch build/main.js",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "start": "node build/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "vitest run --config vitest.api.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "node build/infrastructure/persistence/seed.js",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "license": "ISC",
  "nx": {
    "tags": [
      "type:app",
      "deployment:monolith"
    ]
  },
  "dependencies": {
    "@cadastre/api-contracts": "workspace:*",
    "@cadastre/logger": "workspace:*",
    "@cadastre/matching-engine": "workspace:*",
    "@nestjs/common": "catalog:nestjs12",
    "@nestjs/config": "catalog:nestjs12",
    "@nestjs/core": "catalog:nestjs12",
    "@nestjs/platform-express": "catalog:nestjs12",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "catalog:tooling",
    "prisma": "^7.9.0",
    "testcontainers": "^12.1.0",
    "vitest": "catalog:tooling"
  }
}
