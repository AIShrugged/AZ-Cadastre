// How the archive spells where a property is — one row per spelling, because
// there is never only one.
//
// The state register extract prints two in a single cell: the URIS-assigned
// form the object carries now ("AZ 1093, Bakı şəhəri, Xəzər rayonu, Buzovna
// qəsəbəsi, 259-cu Buzovna küçəsi, giriş 14") and, after the words `Köhnə
// ünvan:`, the one it carried before ("Bakı şəhəri, Xəzər rayonu, Buzovna
// qəsəbəsi, sahə 5-862"). The legacy registers hold a third and a fourth, in
// their own abbreviations and sometimes in the Azerbaijani Cyrillic code page.
//
// A submission written against any of them is about the same property, so all
// of them are searchable and the current one is what the register answers with.

enum AddressKind {
  Current // the URIS-assigned form, the one the register now spells it by
  Legacy // `Köhnə ünvan` — the form the same extract prints underneath
  Register // as one of the archive's own registers writes it
}

model RegistryAddress {
  id       String         @id @default(uuid()) @db.Uuid
  objectId String         @db.Uuid
  object   RegistryObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  kind  AddressKind
  value String

  // ── the parts, where the register kept them apart ────────────────────────
  // Most of the legacy registers do not write an address in one cell: the
  // individual-house inventories head `Qəsəbə | Küçə | Ev | dal/dön`, the
  // apartment-building lists `Küçə adı | Ev № | JEK №`, the dacha table
  // `RAYON | NAME_OF_ME | N_DACH | ADRESS`. `value` is always the whole spelling,
  // joined as the register would read it aloud, and it is what matching reads;
  // the parts are what the register itself distinguished and nothing more —
  // never split out of a one-cell address on the way in.
  district   String?
  settlement String?
  /// `Bağ massivi` / `NAME_OF_ME` — the massif a garden or dacha plot lies in.
  massif     String?
  street     String?
  house      String?
  /// `dal/dön`, `dalan`, `döngə` — the dead end or turning off the street.
  lane       String?
  apartment  String?
  /// `Bağ nömrəsi`, `N_DACH`, `sahə 5-862` — a plot number in place of a house.
  plotNo     String?
  postalCode String?

  /// Which register this spelling was read out of, for the same reason the
  /// object records it: two registers write one address two ways, and a lookup
  /// that resolved through the odd one should be able to say so.
  sourceDatabase String?

  /// The order the record lists them in, so the canonical form stays first
  /// within its kind.
  position Int

  legacyRow   LegacyRow? @relation(fields: [legacyRowId], references: [id], onDelete: SetNull)
  legacyRowId String?    @db.Uuid

  createdAt DateTime @default(now())

  @@index([objectId])
  @@index([legacyRowId])
  @@map("registry_addresses")
}
