// Who the register says holds the property — the `Hüquq sahibləri` table of the
// state register extract, plus the `Şəhadətnamə verilir` column of the older
// privatisation registers.
//
// One free-text name column, for people and firms alike, because that is what
// every source has: `Əliyeva Rübabə Kavı qızı` and `"Qərənfil 97" firması` sit
// in the same column of the same sheet. `kind` is recorded beside it rather
// than split into two tables, since which of the two a row is cannot always be
// told from the text and a wrong guess would hide the record.

enum RightHolderKind {
  Individual
  LegalEntity
}

/// Whether the register holds this person as the holder now or held them once.
/// `tarix.DBF` — `tarix`, history — is 419 637 entries keyed on the case number
/// `NOMKV` with a name, a date and a ground each, which reads as one row per
/// holder the case ever had; a register that could only say "the owner" would
/// have to throw all but the last of them away.
enum RightHolderStanding {
  Current
  Former
  Unknown
}

model RegistryRightHolder {
  id       String         @id @default(uuid()) @db.Uuid
  objectId String         @db.Uuid
  object   RegistryObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  /// `Hüquq sahibinin adı`, in the source's own form — surname, given name,
  /// patronymic as `oğlu`/`qızı`. Never reordered or transliterated on the way
  /// in: what the record says is the evidence, and the matching rules are what
  /// forgive the spelling.
  name String
  kind RightHolderKind

  /// The parts, where the source kept them apart — `FAMILY`, `F_NAME`, `L_NAME`
  /// in the dacha table. `name` is still the whole, joined in the source's order;
  /// the parts are never split out of a one-cell name.
  surname    String?
  givenName  String?
  patronymic String?

  standing RightHolderStanding @default(Current)

  /// `Payı` — "Tam" for the whole, otherwise a fraction as written.
  share String?

  /// `Qeydiyyat nömrəsi` and `Qeydiyyat tarixi`: the number and date of the act
  /// that registered this right. Not a key of the object — one object collects
  /// many of them over the years.
  registrationNo String?
  registeredOn   String?

  /// `İlkin mülkiyyətçi` — who the register says held it before. This is the
  /// column the 2008 transfer of cases between the Absheron and Baku offices is
  /// known to have rewritten, which is why it is kept rather than overwritten.
  previousOwner String?

  /// When this holder's right began and ended, as written, and on what ground
  /// — `ASAS`, `Hansı yol ilə özəlləşib`. Text for the reason `registeredOn` is.
  acquiredOn String?
  endedOn    String?
  basis      String?

  /// VÖEN for a legal entity, identity document for a person, where the source
  /// carried one.
  taxOrDocumentNo String?

  position Int

  legacyRow   LegacyRow? @relation(fields: [legacyRowId], references: [id], onDelete: SetNull)
  legacyRowId String?    @db.Uuid

  createdAt DateTime @default(now())

  @@index([objectId])
  @@index([legacyRowId])
  @@map("registry_right_holders")
}
