# Environment for the running service. Copy to .env (or .env.local, which wins).
#
# This is the only file any of it is read from: the composition root validates
# the whole environment against one schema at startup and hands each context a
# typed slice, so nothing under packages/ reads process.env. Migrations are the
# exception — they are run from the context package and read that package's own
# .env, which needs DATABASE_URL only. See
# packages/verification/.env.example.

# ── Service (composition root) ──────────────────────────────────────────────
SERVICE_PORT=3000
SERVICE_HOST=0.0.0.0

# Origin of the web app, allowed by CORS (API + presigned bucket uploads).
# One origin and never a wildcard: the session is a cookie, so the API answers
# with `credentials: true`, and a browser refuses that combined with `*`.
WEB_ORIGIN=http://localhost:5173

# ── Sessions (the HTTP edge) ────────────────────────────────────────────────
# Everything under /api needs a session except the four /api/auth routes. The
# session is an httpOnly, SameSite=Lax cookie holding a signed statement of the
# account id and an expiry — not a token the client stores, because the web
# client is a browser app and a token JavaScript can read is a token every XSS
# can read (ADR-0029).
#
# The key it is signed with. Leave it out and the server invents one per
# process, which is fine for a laptop and wrong for anything shared: a restart
# then signs everybody out and a second replica accepts nothing the first one
# issued. The start-up line says which of the two happened.
SESSION_SECRET=a-local-development-session-secret
# Seconds. A week: long enough not to sign an operator in twice a day, short
# enough that a token taken off a laptop stops working.
SESSION_TTL=604800
# `Secure` on the cookie. Keep it false on plain HTTP — a Secure cookie there is
# one the browser never sends back, and the symptom is a login that appears to
# work and then 401s. True anywhere there is TLS.
SESSION_COOKIE_SECURE=false

# ── accounts context: database (PostgreSQL) ─────────────────────────────────
# The accounts context owns this one, and deliberately not cadastre-db: a
# context owns its database, and two contexts on one is how a join across the
# boundary gets written by accident (ADR-0029).
ACCOUNTS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cadastre-accounts?schema=public

# ── accounts context: the two seeded accounts ───────────────────────────────
# Put in at start-up if they are not there already, so a stack brought up from
# nothing can be signed into:
#
#   | login               | password   | role     | first / last name   |
#   | ------------------- | ---------- | -------- | ------------------- |
#   | cadastre-operator   | 12345678   | operator | Cadastre / Operator |
#   | cadastre-user       | 12345678   | user     | Cadastre / Applicant|
#
# The logins are fixed in the code and are logins, not addresses — nothing
# validates them as email. Only the passwords are configured, and they default
# to the value above so that a fresh clone signs in with no file edited first.
# That default is published in this repository, so the server warns at start-up
# on every stand still using it and names the variable that replaces it. Change
# both before anybody else can reach the stand.
#
# Changing one of these later does nothing: the seed leaves an account that
# exists alone rather than resetting a credential (TECH_DEBT §16).
SEED_OPERATOR_PASSWORD=12345678
SEED_USER_PASSWORD=12345678

# ── Logging ─────────────────────────────────────────────────────────────────
# Everything the service has to say goes to the console as one structured line
# per event: the run of a package stage by stage, every request with its status
# and duration, and every model call with its model, its tokens and what it
# answered.
#
# fatal | error | warn | info | debug | trace | silent.
# "info" is the run itself. "debug" adds the SQL the context runs, the requests
# it receives before they are answered, every object read from or written to
# storage, and each stage as it starts — which is the level to reach for when a
# package did something surprising. "trace" adds the SQL parameters, which are
# the data itself, so it is for a local database and nothing else.
LOG_LEVEL=info
# Colourised and indented for a terminal. Set to false in a container, where
# one JSON object per line is what a collector can read.
LOG_PRETTY=true

# ── verification context: database (PostgreSQL) ─────────────────────────────
# The context owns this database. Nothing else may connect to it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cadastre-db?schema=public

# ── verification context: object storage (RustFS / S3) ─────────────────────
# Endpoint must be reachable from BOTH this service and the browser, since the
# presigned URL points straight at it. For local RustFS that's localhost:9000.
S3_ENDPOINT=http://localhost:9000
S3_REGION=rustfs
S3_BUCKET=documents
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL=600

# ── verification context: PDF rendering ─────────────────────────────────────
# Every PDF sheet is rendered to an image at this resolution before the reader
# sees it. 300 is the floor at which a photocopied identity card is legible:
# the card fills about a quarter of the A4 sheet, so at 150 its number is some
# 40 pixels wide and every model tested made one up. Raising it costs upload
# bytes and time per page, not accuracy — see docs/MODELS.md.
PDF_PAGE_DPI=300
# The pipeline runs in-process, so one upload cannot occupy it indefinitely.
PDF_MAX_PAGES=30

# ── verification context: OpenRouter ────────────────────────────────────────
# Shared by the real OCR, classifier and extractor adapters. Required only when
# a provider below is set to "openrouter".
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=AZ-Cadastre

# ── verification context: OCR ───────────────────────────────────────────────
# "mock" derives text from the filename; "openrouter" runs a real vision model
# over the rendered page image.
#
# Model choice is not free here: the transcription is what every later stage
# reads, and the confidence attached to it is only real if the route returns
# token logprobs. This one does, from every provider it is served by, and it
# reads Azerbaijani in both scripts. See docs/MODELS.md before changing it.
OCR_PROVIDER=mock
OCR_MODEL=qwen/qwen2.5-vl-72b-instruct

# ── verification context: segmentation ──────────────────────────────────────
# An uploaded file is a container: one PDF may hold several documents. This
# decides which sheets start a new one. "mock" watches for a change of English
# keyword between sheets; "openrouter" asks an LLM (language-agnostic).
# One call per file, over the head and foot of every sheet — worth a model that
# reasons well over a long transcript.
SEGMENTER_PROVIDER=mock
SEGMENTER_MODEL=openai/gpt-4o

# ── verification context: classification ────────────────────────────────────
# "mock" matches English keywords; "openrouter" asks an LLM (language-agnostic).
CLASSIFIER_PROVIDER=mock
CLASSIFIER_MODEL=openai/gpt-4o

# ── verification context: field extraction ──────────────────────────────────
# "mock" returns fixed demo values; "openrouter" reads the schema's fields off
# the sheets — as pictures as well as transcriptions — so this must be a model
# that takes images.
EXTRACTOR_PROVIDER=mock
EXTRACTOR_MODEL=qwen/qwen2.5-vl-72b-instruct

# ── verification context: cross-document verification ───────────────────────
# Holds the documents against each other on the values the profile says must
# agree — the name on the identity card against the name the application is
# made in. "mock" compares the values after folding away spelling;
# "openrouter" asks an LLM, which is what reads a name through its case ending
# and its script. Text only, so this need not take images.
CROSS_CHECKER_PROVIDER=mock
CROSS_CHECKER_MODEL=openai/gpt-4o

# ── verification context: the archive register ──────────────────────────────
# The sixth stage, and the only one that leaves the submission: it asks the
# archive what it holds about the property and which of the package's papers it
# has the original of (ADR-0009, ADR-0010).
#
# "mock" is the stand-in built into the context — three records, addresses
# compared letter for letter, no process and no network. It is the default, so
# leaving these three lines out is choosing it: a run then reports every real
# property as unconfirmed, and the note on the check says which register
# answered. "http" is whoever serves the register contract — locally
# `apps/registry-stub`, which `pnpm dev` starts on 3100 and which answers out of
# the `cadastre-registry` database.
REGISTRY_PROVIDER=http
REGISTRY_URL=http://localhost:3100
# A register that does not answer never fails a verification: the stage is
# abandoned and the report says the property was not confirmed.
REGISTRY_TIMEOUT_MS=5000

# ── verification context: the National Archive Fund ─────────────────────────
# Every paper that prints a QR code has it decoded off the symbol and resolved
# with whoever issued it (ADR-0028, ADR-0034). Decoding needs nothing here: it
# is arithmetic, and there is no provider to choose. This setting is about who
# is asked afterwards.
#
# "mock" is the stand-in built into the context: it holds one paper — the 1998
# allotment order in the Rusadze case — and answers "not found" to anything
# else, which is told to the inspector and never held against the package.
#
# "http" calls the archive's own electronic document service, which says who
# signed a certified copy and whether that signature still verifies. It states
# nothing about what the paper says, so the eight-line comparison against the
# archive's copy is still the stand-in's alone.
#
# "http" is the one setting in this file that sends something off the machine
# that is not ours: the case id printed on the applicant's sheet. It goes to the
# body that issued the sheet and printed the code inviting the check, and to
# nobody else — a code issued by the register or by a notary is never sent
# anywhere. "mock" is the default for that reason; docker-compose sets "http".
NATIONAL_ARCHIVE_PROVIDER=mock
NATIONAL_ARCHIVE_URL=https://api.esd.milliarxiv.gov.az/signature-info/api
# An archive that does not answer never fails a verification: the paper is left
# unchecked and the report says it was not confirmed.
NATIONAL_ARCHIVE_TIMEOUT_MS=5000
