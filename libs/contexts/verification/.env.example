# ── Service ─────────────────────────────────────────────────────────────────
SERVICE_PORT=3000
SERVICE_HOST=0.0.0.0

# Origin of the web app, allowed by CORS (API + presigned bucket uploads)
WEB_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Canonical connection string, consumed by both Prisma and the app.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cadastre-db?schema=public

# ── Object storage (RustFS / S3) ───────────────────────────────────────────
# Endpoint must be reachable from BOTH this service and the browser, since the
# presigned URL points straight at it. For local RustFS that's localhost:9000.
S3_ENDPOINT=http://localhost:9000
S3_REGION=rustfs
S3_BUCKET=documents
# S3 access credentials for RustFS.
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL=600

# ── OpenRouter (shared by the real OCR + classifier adapters) ───────────────
# Required only when a provider below is set to "openrouter".
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=AZ-Cadastre

# ── OCR ─────────────────────────────────────────────────────────────────────
# "mock" derives text from the filename; "openrouter" runs a real vision model
# over the uploaded image bytes.
OCR_PROVIDER=mock
OCR_MODEL=google/gemini-2.5-flash

# ── Segmentation ────────────────────────────────────────────────────────────
# An uploaded file is a container: one PDF may hold several documents. This
# decides which sheets start a new one. "mock" watches for a change of English
# keyword between sheets; "openrouter" asks an LLM (language-agnostic).
SEGMENTER_PROVIDER=mock
SEGMENTER_MODEL=google/gemini-2.5-flash

# ── Classification ──────────────────────────────────────────────────────────
# "mock" matches English keywords; "openrouter" asks an LLM (language-agnostic).
CLASSIFIER_PROVIDER=mock
CLASSIFIER_MODEL=google/gemini-2.5-flash

# ── Field extraction ────────────────────────────────────────────────────────
# "mock" returns fixed demo values; "openrouter" pulls schema fields via an LLM.
EXTRACTOR_PROVIDER=mock
EXTRACTOR_MODEL=google/gemini-2.5-flash

# ── Cross-document verification ─────────────────────────────────────────────
# Holds the documents against each other on the values the profile says must
# agree. "mock" compares the values after folding away spelling; "openrouter"
# asks an LLM, which is what reads a name through its case ending and its
# script. Text only — it sees the values, not the sheets.
CROSS_CHECKER_PROVIDER=mock
CROSS_CHECKER_MODEL=google/gemini-2.5-flash
