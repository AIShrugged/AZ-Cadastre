// Prisma schema for @cadastre/verification (multi-file — one model per file).
//
// This context owns its database: the schema, the generated client and the
// migration history all live under infrastructure/persistence, never in a
// shared package. That is what makes "a transaction never spans two contexts"
// something the wiring cannot express, rather than a rule anyone has to
// remember.
//
// These tables are the persistence view of the domain model (ADR-0004), mapped
// explicitly by the repositories beside them and never imported by the domain.
//
// Verification Profiles are NOT modelled here: they live in code, not the
// database (ADR-0002).

generator client {
  provider     = "prisma-client"
  output       = "../generated"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}
