{
  "name": "cadastre",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t watch dev -p tag:deployment:monolith",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint apps/ libs/ packages/",
    "test": "nx run-many -t test",
    "test:watch": "nx run-many -t test:watch",
    "test:coverage": "nx run-many -t test:coverage",
    "prettier": "prettier --write \"{apps,libs,packages}/**/*.{ts,tsx,json}\"",
    "prettier:check": "prettier --check \"{apps,libs,packages}/**/*.{ts,tsx,json}\"",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nx": "^23.1.1",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "**/!(*.generated).{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
