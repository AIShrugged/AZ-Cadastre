# Migrations only.
#
# This context does not read the environment at runtime: the composition root
# validates it once and hands the module a typed slice (see
# apps/server/.env.example). Prisma Migrate is the exception — it is run from
# this package, outside Nest, and needs the connection string here.
#
# Copy to .env (or .env.local, which wins).

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cadastre-db?schema=public
