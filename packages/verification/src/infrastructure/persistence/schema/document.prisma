// One logical document found inside a source file: a run of that file's sheets
// carrying exactly one Document Type. Written by the Segmentation stage, which
// reads a container file into the documents it actually holds, then filled in
// by Classification and Field extraction.

model Document {
  id           String     @id @default(uuid()) @db.Uuid
  sourceFileId String     @db.Uuid
  sourceFile   SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)

  /// Denormalised from the owning file so a package's documents can be counted
  /// and listed without walking every file it contains.
  packageId String              @db.Uuid
  package   VerificationPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  // The sheets of `sourceFile` this document occupies, 1-based and inclusive.
  // A file's documents tile it: back to back, no gaps, no overlaps.
  firstPage Int
  lastPage  Int

  /// Detected document type — a profile-defined string key (ADR-0002), e.g.
  /// "passport" | "driver_license" | "application" | "unknown". Null until the
  /// Classify stage runs. Kept as a string so a new profile/domain never
  /// requires a migration.
  type String?

  /// Classifier confidence for `type`, 0..1. Null until the Classify stage runs.
  classificationConfidence Float?

  /// Which entry of the document catalogue the classifier recognised this
  /// document as, when `type` is "out_of_profile" and it recognised one — e.g.
  /// "courier_waybill" (ADR-0012). Null on every other reading, and null on a
  /// document out of profile that the catalogue has no name for. A key and not
  /// a name, for the reason `type` is: the catalogue lives in code, so a paper
  /// added to it never needs a migration.
  knownAs String?

  /// The document that replaced this one, and when it did (COMM-80).
  ///
  /// Null on nearly every row, which is what "in force" means. A replaced
  /// document is never deleted: an operator sends a better scan of a paper the
  /// run read badly, and the bad scan stays in the package, marked, saying what
  /// replaced it and on what day — a submission is evidence and not a working
  /// draft. Everything worked out *about* the package — the report, the
  /// cross-document checks, the questions put to the register, the values a row
  /// names the case by — reads only the rows where this is null.
  ///
  /// SetNull and not Cascade: what replaced it is a pointer for the reader, and
  /// losing that pointer must not take the record of the replacement with it.
  /// `supersededAt` is what says the document is out of force, so it is the one
  /// of the two that decides anything.
  supersededById String?    @db.Uuid
  supersededBy   Document?  @relation("Supersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     Document[] @relation("Supersedes")
  supersededAt   DateTime?

  extractedFields         ExtractedField[]         @relation("ReadOff")
  /// Fields of *other* documents whose value was carried over from this one
  /// (ADR-0023). Named, because a document is on both ends of that relation.
  gatheredFrom            ExtractedField[]         @relation("GatheredFrom")
  validationIssues        ValidationIssue[]
  crossCheckValues        CrossCheckValue[]
  registryChecks          RegistryCheck[]
  registryCheckAttributes RegistryCheckAttribute[]
  registryCheckDocuments  RegistryCheckDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Where a document starts is what a re-run of segmentation identifies it by,
  // so the stage is an idempotent upsert rather than a duplicate.
  @@unique([sourceFileId, firstPage])
  @@index([packageId])
  // Not for a query but for the cascade, the same reason the carried-over
  // values are indexed by their source: clearing this column has to find the
  // rows that point here.
  @@index([supersededById])
  @@map("documents")
}
