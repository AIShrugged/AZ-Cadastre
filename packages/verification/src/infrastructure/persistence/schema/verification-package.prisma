// Aggregate root: a Verification Package — one upload of one or more files.
// A file is a container: the pipeline reads it into the one-or-more Documents
// it actually holds (PRD §3).

/// Pipeline lifecycle of a package — distinct from the verification *outcome*
/// (OK / Issues Found / Incomplete), which belongs to the Report aggregate.
enum PackageStatus {
  Pending // uploaded, pipeline not started
  Processing // pipeline running (split → OCR → segment → classify → extract → validate)
  Completed // pipeline finished, report available
  Failed // pipeline hit a permanent error
}

model VerificationPackage {
  id     String        @id @default(uuid()) @db.Uuid
  status PackageStatus @default(Pending)

  /// Which Verification Profile governs this package — a profile string key
  /// (ADR-0002), e.g. "demo" | "cadastre". The profile definition itself lives
  /// in code, not here; this only records which one was chosen at upload.
  profileKey String

  /// Optimistic concurrency: every aggregate carries a version that takes part
  /// in every write. An update names the version it was loaded at in its WHERE
  /// clause and bumps it, so a concurrent write is refused rather than silently
  /// overwritten.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceFiles SourceFile[]
  documents   Document[]
  crossChecks    CrossCheck[]
  registryChecks RegistryCheck[]
  report         Report?

  /// What a person signed for about the archive search, newest last. A history
  /// and not a field: an approval covers the state of the search it was given,
  /// and a run that asks the register again ends it (ADR-0016).
  archiveSearchApprovals ArchiveSearchApproval[]

  /// When the submission was accepted, which is the one column a summary of a
  /// period is narrowed by — for its own tally and, across a join, for the
  /// reports, the findings and the register's answers alike. Without it every
  /// period is a full scan of the table, and the table only ever grows.
  @@index([createdAt])
  @@map("verification_packages")
}
